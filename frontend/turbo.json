{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },

    // Para codar
    "dev":{
      "cache": false,
      "persistent": true
    },

      // lint
    "lint": {
      "dependsOn": ["^lint"]
    },

    // Verificacao tipo
  "check-types": {
      "dependsOn": ["^build"]
    },

    "clean": {
      "cache": false
    }
  }
}
